{"parameters":[{"caption":"A full slider","group":"Sliders","initial":10.0,"max":20.0,"min":0.0,"name":"slider","step":0.5,"type":"number"},{"caption":"Min and max only","group":"Sliders","initial":5.0,"max":10.0,"min":0.0,"name":"range","step":1.0,"type":"number"},{"caption":"Max only","group":"Sliders","initial":3.0,"max":10.0,"min":0.0,"name":"max_only","step":1.0,"type":"number"},{"group":"Choices","initial":2.0,"name":"num_choice","options":[{"name":"1","value":1.0},{"name":"2","value":2.0},{"name":"3","value":3.0}],"type":"number"},{"group":"Choices","initial":10.0,"name":"labelled","options":[{"name":"Small","value":10.0},{"name":"Medium","value":20.0},{"name":"Large","value":30.0}],"type":"number"},{"group":"Choices","initial":"a","name":"str_choice","options":[{"name":"Apple","value":"a"},{"name":"Banana","value":"b"}],"type":"string"},{"group":"Other","initial":"hello","maxLength":8,"name":"text","type":"string"},{"group":"Other","initial":false,"name":"flag","type":"boolean"},{"group":"Other","initial":[1.0,2.0],"name":"vec2","type":"number"},{"group":"Other","initial":[1.0,2.0,3.0],"max":10.0,"min":0.0,"name":"vec3","step":1.0,"type":"number"},{"group":"Other","initial":1.5,"name":"spin","step":1.0,"type":"number"}],"title":"types"}